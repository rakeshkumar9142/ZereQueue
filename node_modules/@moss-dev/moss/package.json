{
  "name": "@moss-dev/moss",
  "version": "1.7.1",
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/moss.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/moss.d.ts",
      "node": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist temp .log",
    "build": "npm run build:types && npm run build:js && api-extractor run --local",
    "build:dev": "npm run build:types && npm run build:js",
    "build:watch": "tsx esbuild.watch.config.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "tsx esbuild.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "run-query-sample": "tsx samples/query.ts",
    "run-multi-index": "tsx samples/multiple-indexes.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "extract-api": "npm run build && api-extractor run --local",
    "prepack": "npm run clean && npm run build",
    "docs": "typedoc --options typedoc.json && mkdir -p ../../documentation/docs/public/reference/js/_media && cp LICENSE.txt ../../documentation/docs/public/reference/js/_media/LICENSE.txt"
  },
  "files": [
    "dist/index.esm.js",
    "dist/moss.d.ts",
    "README.md",
    "LICENSE.txt"
  ],
  "keywords": [
    "search",
    "semantic",
    "embeddings",
    "vector",
    "inferedge"
  ],
  "author": "InferEdge Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@moss-dev/moss-core": "0.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/javascript-obfuscator": "^0.0.5",
    "@types/node": "^22.20.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "esbuild-plugin-obfuscator": "^1.2.4",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.4"
  }
}
